# Copia este archivo como `.env` (o define las variables en Railway) y ajusta los valores.
# La aplicación SOLO arranca en modo estricto si defines JWT_SECRET y ADMIN_PASSWORD reales.

# --- Seguridad (OBLIGATORIOS) ---
# Secreto para firmar tokens JWT. Mínimo 32 caracteres, token aleatorio.
JWT_SECRET=reemplaza-con-un-secreto-largo-y-aleatorio-de-al-menos-32-caracteres

# Contraseña inicial del usuario administrador (se aplica en cada deploy, ver UsuarioSeeder).
ADMIN_PASSWORD=cambia-esta-contrasena

# Controla si la app se niega a arrancar con valores por defecto. true en producción.
STRICT_SECRETS=true

# --- Opcionales ---
# Duración del token JWT en milisegundos (default 1 día).
JWT_EXPIRATION_MS=86400000

# Orígenes permitidos para CORS, separados por coma.
APP_CORS_ORIGINS=https://ositopanda-app.vercel.app,http://localhost:*,http://localhost:5173

# Habilita Swagger/OpenAPI (default false).
SPRINGDOC_ENABLED=false