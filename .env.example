# Variables de entorno para el backend (Spring Boot)
# Copia este archivo a .env y completa los valores reales.
# El archivo .env NO se sube al repositorio (ver .gitignore).

# Conexión a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/gordoarepas_dev
DB_USERNAME=postgres
DB_PASSWORD=tu_password

# Orígenes CORS permitidos (coma-separado, se aceptan patrones)
APP_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://ositopanda-app.vercel.app

# Seguridad / JWT (clave secreta y duración del token en ms)
JWT_SECRET=genera_una_clave_larga_y_secreta_de_al_menos_32_bytes
JWT_EXPIRATION_MS=86400000

# Contraseñas iniciales de los usuarios sembrados (admin / ventas)
ADMIN_PASSWORD=cambia_admin
VENTAS_PASSWORD=cambia_ventas

